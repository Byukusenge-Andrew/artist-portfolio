{
  "ignoreCommand": "if [ \"$VERCEL_ENV\" = \"production\" ]; then exit 1; else exit 0; fi",
  "cleanUrls": true,
  "redirects": [
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "www.artelier.work.gd"
        }
      ],
      "destination": "https://artelier.work.gd/$1",
      "permanent": true
    }
  ]
}
