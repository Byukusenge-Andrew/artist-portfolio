{
  "name": "artist-portfolio",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "concurrently \"next dev -p 3001\" \"local-ssl-proxy --source 3000 --target 3001 --cert certs/localhost.crt --key certs/localhost.key\"",
    "dev:http": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "next lint",
    "migrate": "prisma migrate dev",
    "generate": "prisma generate",
    "generate:certs": "node scripts/generate-certs.js",
    "setup:ssl": "node scripts/generate-certs.js && echo SSL setup complete! Run 'npm run dev' to start HTTPS server."
  },
