// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")

 // sslcert  = env("SSL_CERT_PATH")

}
 
// Portfolio data models


enum OrderStatus {
  PENDING
  PAID
  FULFILLED
  CANCELED
}

enum CommissionStatus {
  NEW
  IN_REVIEW
  INVOICE_SENT
  PAID
  REJECTED
}

enum ProductType {
  ORIGINAL
  PRINT
  COMMISSION
}

model Artwork {
  id                  String        @id @default(cuid())
  title               String
  slug                String        @unique
  description         String?       @db.Text
  imagePublicId       String
  imageUrl            String        @db.LongText
  width               Int?
  height              Int?
  tags                Json?
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt

  // Original piece info
  isOriginalAvailable Boolean       @default(true)
  originalPriceCents  Int?

  // Prints
  printEnabled        Boolean       @default(false)
  printOptions        PrintOption[]

  // Galleries (many-to-many)
  galleries           ArtworkGallery[]

  // Order items referencing snapshot of artwork
  orderItems          OrderItem[]
}

model PrintOption {
  id         String   @id @default(cuid())
  artworkId  String
  name       String   // e.g., "A4", "A3", "12x16 in"
  priceCents Int

  artwork    Artwork  @relation(fields: [artworkId], references: [id], onDelete: Cascade)
  orderItems OrderItem[]
}

model Gallery {
  id          String           @id @default(cuid())
  name        String
  slug        String           @unique
  description String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  artworks    ArtworkGallery[]
}

model ArtworkGallery {
  artworkId String
  galleryId String

  artwork   Artwork @relation(fields: [artworkId], references: [id], onDelete: Cascade)
  gallery   Gallery @relation(fields: [galleryId], references: [id], onDelete: Cascade)

  @@id([artworkId, galleryId])
}

model Order {
  id          String       @id @default(cuid())
  email       String
  customerName String?
  status      OrderStatus  @default(PENDING)
  currency    String       @default("usd")
  totalCents  Int          @default(0)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  items       OrderItem[]
}

model OrderItem {
  id            String      @id @default(cuid())
  orderId       String
  productType   ProductType
  quantity      Int         @default(1)

  // Artwork association (for ORIGINAL or PRINT)
  artworkId     String?
  printOptionId String?

  // Snapshots to preserve state at order time
  titleSnapshot String
  imageUrlSnapshot String
  unitPriceCents Int

  order         Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  artwork       Artwork?    @relation(fields: [artworkId], references: [id])
  printOption   PrintOption? @relation(fields: [printOptionId], references: [id])
}

model CommissionRequest {
  id           String           @id @default(cuid())
  name         String
  email        String
  details      String
  referenceImagePublicId String?
  referenceImageUrl      String?
  status       CommissionStatus  @default(NEW)
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
}

// Artist/Admin profile for signup
model Artist {
  id              String   @id @default(cuid())
  name            String
  email           String?  @unique
  phone           String?
  bio             String?
  avatarPublicId  String?
  avatarUrl       String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}